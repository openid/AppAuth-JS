{
    "compilerOptions": {
        "module": "esnext",
        "target": "es6",
        "lib": [
            "dom",
            "ES2015"
        ],
        "rootDirs": [
            "src",
            "app"
        ],
        "outDir": "built",
        "noImplicitAny": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "jsx": "react",
        "strict": true,
        "declaration": true,
        "noEmitOnError": true,
        "inlineSourceMap": true,
        "inlineSources": true,
        "types": [
            "base64-js",
            "jquery",
            // Dev dependencies
            "hapi",
            "node",
            "react",
            "react-dom",
            "vitest/globals"
        ],
    },
    "exclude": [
        "node_modules",
        "built",
        "vitest.config.ts",
        "vite.config.ts",
    ],
    "compileOnSave": true
}
